---
import GeneratorPreview from "../components/GeneratorPreview.astro";
import GeneratorSettings from "../components/GeneratorSettings.astro";
import QrSpecification from "../components/QrSpecification.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  activePage="generator"
  description="Generate QR codes locally in your browser"
  heading="Create a safe QR code"
  title="QR Code Generator"
>
  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(20rem,2fr)]">
    <GeneratorSettings />
    <GeneratorPreview />
  </div>
  <QrSpecification />
</SiteLayout>

<script>
  import "../scripts/app.ts";
</script>
