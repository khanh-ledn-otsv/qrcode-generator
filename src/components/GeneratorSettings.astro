---
import Trash2 from "@lucide/astro/icons/trash-2";
---

<section aria-labelledby="settings-heading">
  <h2 id="settings-heading" class="text-lg font-semibold text-text">Settings</h2>
  <label for="base-url" class="mt-4 block text-sm font-semibold text-text">Base URL <span class="text-brand">*</span></label>
  <input id="base-url" type="url" class="mt-1 w-full rounded-md border border-border bg-page px-3 py-2 text-sm text-text outline-none focus:border-focus focus:ring-2 focus:ring-focus/20" placeholder="E.g. https://example.com/promo" autocomplete="url" aria-describedby="base-url-counts url-validation" />
  <p id="base-url-counts" class="mt-1 text-xs text-text-muted">0 characters | 0 UTF-8 bytes</p>
  <p id="url-validation" class="mt-2 min-h-5 text-sm font-semibold text-red-700" role="alert" aria-live="polite"></p>
  <section class="mt-4 rounded-lg bg-surface p-4" aria-labelledby="utm-heading">
    <div class="flex items-center justify-between gap-4"><h3 id="utm-heading" class="text-sm font-semibold text-text">UTM Configuration</h3><label class="relative inline-flex cursor-pointer items-center"><input id="utm-enabled" class="peer sr-only" type="checkbox" checked aria-label="Enable UTM configuration" aria-controls="utm-content" aria-expanded="true" /><span class="pointer-events-none h-5 w-9 rounded-full bg-text-muted transition peer-checked:bg-brand after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-page after:transition peer-checked:after:translate-x-4"></span><span class="sr-only">Enable UTM configuration</span></label></div>
    <div id="utm-content">
      <div id="utm-fields" class="mt-4 grid gap-4 sm:grid-cols-2"><label class="block text-xs font-semibold text-text">utm_source<input id="utm-source" class="mt-1 w-full rounded-md border border-border bg-page px-3 py-2 text-sm outline-none focus:border-focus focus:ring-2 focus:ring-focus/20" aria-label="utm_source" placeholder="Where the scan comes from" /></label><label class="block text-xs font-semibold text-text">utm_medium<input id="utm-medium" class="mt-1 w-full rounded-md border border-border bg-page px-3 py-2 text-sm outline-none focus:border-focus focus:ring-2 focus:ring-focus/20" aria-label="utm_medium" placeholder="The channel" /></label><label class="block text-xs font-semibold text-text sm:col-span-2">utm_campaign<input id="utm-campaign" class="mt-1 w-full rounded-md border border-border bg-page px-3 py-2 text-sm outline-none focus:border-focus focus:ring-2 focus:ring-focus/20" aria-label="utm_campaign" placeholder="Campaign name" /></label></div>
      <div id="custom-params" class="mt-4 grid gap-3"></div><template id="remove-parameter-icon-template"><Trash2 class="h-5 w-5" stroke-width="1.75" /></template><button id="add-param" class="mt-4 text-sm font-semibold text-brand hover:text-brand-dark" type="button">+ Add Parameter</button>
    </div>
  </section>
  <label for="encoded-url" class="mt-4 block text-sm font-semibold text-text">Encoded URL <span class="font-normal italic text-text-muted">- Automatic generation</span></label><textarea id="encoded-url" class="mt-1 min-h-20 w-full resize-none rounded-md border border-border bg-surface px-3 py-2 text-sm text-text" rows="3" readonly></textarea><p id="encoded-url-guidance" class="mt-1 text-xs text-text-muted">The encoded URL will appear after the base URL is valid.</p>
</section>
